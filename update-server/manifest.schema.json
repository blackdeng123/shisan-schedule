{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://update.example.com/schemas/campuspro-update-manifest-v1.json",
  "title": "闪电课表更新清单",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packageName",
    "versionCode",
    "versionName",
    "apkUrl",
    "apkSizeBytes",
    "sha256",
    "publishedAt",
    "releaseNotes"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "packageName": { "type": "string", "minLength": 1 },
    "versionCode": { "type": "integer", "minimum": 1 },
    "versionName": { "type": "string", "minLength": 1 },
    "apkUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
    "apkSizeBytes": { "type": "integer", "minimum": 1 },
    "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "releaseNotes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
